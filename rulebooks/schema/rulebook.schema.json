{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackbox.example/schemas/rulebook.schema.json",
  "title": "Rulebook",
  "type": "object",
  "additionalProperties": false,
  "required": ["rulebook", "checks"],
  "properties": {
    "rulebook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "type": "string" },
        "derive_from_tools": { "type": "boolean" },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "severity": { "enum": ["info", "minor", "major", "critical"] } }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "taxonomy", "severity", "guard", "assert", "message"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+(-[A-Z0-9]+)+$" },
        "title": { "type": "string" },
        "taxonomy": { "type": "string", "pattern": "^BB-[A-Z]{3}$" },
        "severity": { "enum": ["info", "minor", "major", "critical"] },
        "irreversible": { "type": "boolean" },
        "recovery": { "type": "string" },
        "guard": { "type": "string" },
        "assert": { "type": "string" },
        "message": { "type": "string" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observed": { "type": "string" },
            "expected": { "type": "string" }
          }
        },
        "scope": { "enum": ["step", "pair", "run", "handoff"] }
      }
    }
  }
}
